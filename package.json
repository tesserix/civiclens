{
  "name": "civiclens",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "api": "cargo run -p civiclens-api",
    "test": "jest --runInBand",
    "test:mobile": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm test && npm run typecheck && npm run lint",
    "export": "expo export --platform all"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-picker/picker": "2.11.4",
    "@tanstack/react-query": "5.104.5",
    "expo": "57.0.31",
    "expo-auth-session": "~57.0.16",
    "expo-build-properties": "57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-media-library": "~57.0.5",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18n-iso-countries": "7.14.0",
    "nativewind": "4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-share": "12.3.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "26.6.5",
    "@types/react": "19.2.14",
    "eslint": "10.13.0",
    "jest": "29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
